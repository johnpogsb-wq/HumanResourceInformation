# Keeps local-only and secret files out of the image. Hostforge builds from a
# fresh git clone, so most of this matters for a build run on a laptop — but
# the .env lines matter everywhere: a secret copied into an image layer stays
# readable in that layer even if a later step deletes it.

.git
**/node_modules

# Secrets. The templates carry no values, so they are allowed through.
**/.env
**/.env.*
!**/.env.example
!**/.env.production.example

# Rebuilt inside the image — never copy a laptop's versions in.
backend/vendor
backend/public/build
backend/public/hot
backend/public/storage
backend/bootstrap/cache/*.php
backend/storage/logs/*
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/*.key
frontend/dist

# Not part of the running app.
landing
docs
backend/tests
cookies.txt
backend/storage/cookies.txt
