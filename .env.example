APP_NAME=PrimePower
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# This project runs on PostgreSQL. sqlite is left as the connection here only
# so a fresh clone boots with zero setup; switch to pgsql and fill in real
# credentials (never commit them) to match a real environment.
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=primepower_hris
# DB_USERNAME=postgres
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10
SESSION_IDLE_WARNING=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI document scanner (Ollama, local — see config/scanner.php)
SCANNER_DRIVER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_SCANNER_MODEL=glm-ocr

# Whether the batch filer may file a reading nobody looked at. It only does so
# when all six gates in config/scanner.php agree, and it marks every row it
# files — but this is the one switch in the system that lets a model's reading
# become a stored fact, so it is named here rather than left to be discovered
# in config. Set it to false and the batch filer proposes everything and writes
# nothing, exactly as it did before.
SCANNER_AUTOFILE=true

# Deployment driver for the document scanner. Ollama has to be installed and
# running on whatever serves the app, and a small VPS cannot hold even a 2.2 GB
# vision model — so on a deployed instance the scanner goes dark unless this is
# switched on. Get a key free at https://aistudio.google.com/apikey.
#
# The cost is the one Ollama was chosen to avoid: the scan leaves the country.
# Under RA 10173 that is a cross-border transfer of personal data and needs
# consent and disclosure. Switch a real deployment to it deliberately.
# SCANNER_DRIVER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.7-flash
